<Project>
  <Import Project="$(KiroraReleaseProperties)" Condition="'$(KiroraReleaseProperties)' != ''" />
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable Condition="'$(MSBuildProjectName)' != 'Kirora'">false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">$(MSBuildProjectDirectory)/obj/$(RuntimeIdentifier)/packages.aot.lock.json</NuGetLockFilePath>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <KiroraRepositoryUrl Condition="'$(KiroraRepositoryUrl)' == ''">https://github.com/kiroratech/kirora-dotnet</KiroraRepositoryUrl>
    <!-- Enable built-in SDK SourceLink only for a dedicated checkout; copied/repro sources have no Git provenance. -->
    <KiroraEnableSourceLink Condition="'$(KiroraEnableSourceLink)' == '' and Exists('$(MSBuildThisFileDirectory).git')">true</KiroraEnableSourceLink>
    <EnableSourceControlManagerQueries Condition="'$(KiroraEnableSourceLink)' != 'true'">false</EnableSourceControlManagerQueries>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
